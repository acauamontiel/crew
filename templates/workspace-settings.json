{
  "env": {
    "CREW_WORKTREES": "__WORKTREES__"
  },
  "permissions": {
    "allow": [
      "Bash(docker compose *)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(glab mr *)",
      "Bash(tea pulls *)",
      "Bash(tea comment *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Read(**/.env)"
    ],
    "additionalDirectories": [
      "__WORKTREES__"
    ]
  }
}
