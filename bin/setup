#!/usr/bin/env bash
# Configura o crew nesta máquina. Idempotente: pode rodar de novo a qualquer momento.
#
#   bin/setup
#
# - confere dependências (claude, docker compose, gh autenticado, git, jq)
# - grava CLAUDE_CODE_FORK_SUBAGENT=0 em ~/.claude/settings.json
# - registra este repositório como marketplace "crew" e instala o plugin crew
# - instala o plugin impeccable (usado pelo /crew:ui e pelas variantes do /crew:feature)
# - baixa a imagem Docker do Playwright MCP
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

info "Conferindo dependências"
require claude "Instale o Claude Code: https://claude.com/claude-code"
require git    "Instale o git."
require jq     "Instale com: sudo apt install jq"
require docker "Instale o Docker Engine com o plugin compose."
docker compose version >/dev/null 2>&1 || die "'docker compose' não funciona. Instale o plugin compose do Docker."
require gh     "Instale o GitHub CLI: https://cli.github.com"
gh auth status >/dev/null 2>&1 || die "gh não está autenticado. Rode: gh auth login"
ok "dependências presentes"

info "Configurando ~/.claude/settings.json"
merge_json "$HOME/.claude/settings.json" "$CREW_DIR/templates/user-settings.json"

info "Registrando o marketplace $MARKETPLACE ($CREW_DIR)"
if marketplace_known "$MARKETPLACE"; then
  claude plugin marketplace update "$MARKETPLACE"
else
  claude plugin marketplace add "$CREW_DIR"
fi

info "Instalando o plugin crew (escopo usuário)"
if plugin_installed "crew@$MARKETPLACE"; then
  claude plugin update "crew@$MARKETPLACE"
else
  claude plugin install "crew@$MARKETPLACE" --scope user
fi

info "Instalando o plugin impeccable (escopo usuário)"
if plugin_installed "impeccable@impeccable"; then
  ok "impeccable já instalado"
else
  marketplace_known impeccable || claude plugin marketplace add pbakaus/impeccable
  claude plugin install impeccable@impeccable --scope user
fi

info "Baixando a imagem do Playwright MCP"
docker pull mcr.microsoft.com/playwright/mcp >/dev/null && ok "mcr.microsoft.com/playwright/mcp"

cat <<EOF

Pronto. Próximos passos:
  1. Reinicie as sessões abertas do Claude Code para carregar os plugins e o env.
  2. Em cada workspace (pasta onde você abre o Claude Code), rode:
       $CREW_DIR/bin/init-workspace <workspace>     # ex.: ~/code/acme
EOF
